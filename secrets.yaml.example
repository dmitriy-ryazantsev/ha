# Secrets - DO NOT commit this file to version control
# Copy this file to secrets.yaml and fill in your actual values
# Example:
# http_password: YOUR_PASSWORD_HERE
# api_key: YOUR_API_KEY_HERE
# db_url: postgresql://user:password@localhost/dbname

# Home Assistant
# ha_latitude: 00.000000
# ha_longitude: 00.000000
# ha_elevation: 0

# API Keys
# openweathermap_api_key: YOUR_API_KEY
# spotify_client_id: YOUR_CLIENT_ID
# spotify_client_secret: YOUR_CLIENT_SECRET

# MQTT
# mqtt_broker: 192.168.1.100
# mqtt_username: YOUR_USERNAME
# mqtt_password: YOUR_PASSWORD

# Network
# trusted_network: 192.168.1.0/24
